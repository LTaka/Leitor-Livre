{
  "manifest_version": 3,
  "name": "Leitor Livre — Painel de Leitura",
  "version": "1.0",
  "description": "Painel lateral com navegação por trechos e leitor flutuante clássico restaurado em páginas web.",
  "permissions": [
    "sidePanel",
    "storage",
    "clipboardRead",
    "contextMenus",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir Leitor Livre",
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "append-or-read-copied": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Acrescentar a seleção ou ler o texto copiado"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
